{
  "name": "@openspace/desktop-win",
  "version": "1.0.0-rc.1",
  "description": "OpenSpace — self-hosted communication platform (Windows client)",
  "author": "OpenSpace",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test scripts/ui-layout.test.mjs scripts/security-policy.test.ts scripts/vault-recovery.test.ts",
    "test:e2e": "node e2e/runner.mjs",
    "test:performance": "electron-vite build && node scripts/measure-performance.mjs",
    "test:unit": "node --test scripts/ui-layout.test.mjs scripts/security-policy.test.ts scripts/vault-recovery.test.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.5.5",
    "lucide-react": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.openspace.desktop",
    "productName": "OpenSpace",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SNPK-dev",
        "repo": "OpenSpace",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*"
    ]
  }
}
