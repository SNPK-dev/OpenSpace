# Production LiveKit config.
# Rendered by scripts/render-prod-configs.mjs into .generated/prod/livekit/livekit.yaml

port: 7880
redis:
  address: redis:6379
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true

keys:
  LIVEKIT_KEY_PLACEHOLDER: LIVEKIT_SECRET_PLACEHOLDER

logging:
  level: LOG_LEVEL_PLACEHOLDER

room:
  empty_timeout: 300
  departure_timeout: 20
