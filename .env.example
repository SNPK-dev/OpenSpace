APP_ENV=development
PUBLIC_BASE_URL=http://localhost
ADMIN_BASE_URL=http://localhost/admin
WS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,file://

POSTGRES_DB=openspace
POSTGRES_USER=openspace
POSTGRES_PASSWORD=openspace
POSTGRES_PORT=5432
DATABASE_URL=postgres://openspace:openspace@postgres:5432/openspace

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=files.example.com
OBJECT_STORAGE_BUCKET=openspace
OBJECT_STORAGE_ACCESS_KEY=openspace
OBJECT_STORAGE_SECRET_KEY=change-me-openspace
OBJECT_STORAGE_PUBLIC_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

TURN_HOST=localhost
TURN_SECRET=devturn
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=localhost
TURN_RELAY_PORT_START=50000
TURN_RELAY_PORT_END=50100

CADDY_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=info
LAN_DOMAIN=openspace.lan
LAN_FILES_DOMAIN=files.openspace.lan

# Production container resource ceilings. Tune from observed load; these are
# single-host defaults, not a capacity guarantee.
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512m
API_PIDS_LIMIT=256
GATEWAY_CPU_LIMIT=1.0
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_PIDS_LIMIT=256
ADMIN_WEB_CPU_LIMIT=0.25
ADMIN_WEB_MEMORY_LIMIT=128m
ADMIN_WEB_PIDS_LIMIT=128
WEB_CLIENT_CPU_LIMIT=0.25
WEB_CLIENT_MEMORY_LIMIT=128m
WEB_CLIENT_PIDS_LIMIT=128
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_PIDS_LIMIT=256
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=256m
REDIS_PIDS_LIMIT=128
MINIO_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=512m
MINIO_PIDS_LIMIT=256
MINIO_INIT_CPU_LIMIT=0.25
MINIO_INIT_MEMORY_LIMIT=128m
MINIO_INIT_PIDS_LIMIT=64
WORKER_CPU_LIMIT=0.5
WORKER_MEMORY_LIMIT=256m
WORKER_PIDS_LIMIT=128
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_RETRIES=3
MAINTENANCE_DRY_RUN=false
GRAFANA_ADMIN_PASSWORD=change-me-observability
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512m
GRAFANA_CPU_LIMIT=0.5
GRAFANA_MEMORY_LIMIT=512m
LIVEKIT_CPU_LIMIT=2.0
LIVEKIT_MEMORY_LIMIT=1g
LIVEKIT_PIDS_LIMIT=512
COTURN_CPU_LIMIT=1.0
COTURN_MEMORY_LIMIT=512m
COTURN_PIDS_LIMIT=512
CADDY_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=256m
CADDY_PIDS_LIMIT=256

PUSH_PROVIDER=none
RETENTION_DEFAULT_DAYS=365
MAX_UPLOAD_MB=100
